@article{wolf1997,
  title = {Electromagnetic Diffraction in Optical Systems - {{I}}. {{An}} Integral Representation of the Image Field},
  author = {Wolf, E. and Gabor, Dennis},
  year = {1997},
  month = jan,
  journal = {Proceedings of the Royal Society of London. Series A. Mathematical and Physical Sciences},
  volume = {253},
  number = {1274},
  pages = {349--357},
  publisher = {{Royal Society}},
  doi = {10.1098/rspa.1959.0199},
  urldate = {2023-07-12},
  abstract = {An integral representation is obtained for the electromagnetic field in the image space of an optical
              system . This representation , which is not restricted to systems of low angular aperture, is in the form
              of an angular spectrum of plane waves, and is closely related to that introduced by Luneberg (1944) as a
              vector generalization of well-known formulae of Debye (1909) and Picht (1925). It is shown that the
              representation has a simple physical interpretation in terms of a modified Huygens-Fresnel principle which
              operates with secondary plane waves rather than with secondary spherical waves.},
  annotation = {719 citations (Semantic Scholar/DOI) [2023-07-12]},
  file = {/home/kunzaatko/Zotero/storage/EJY5WLWJ/wolf1959.pdf.pdf},
}

