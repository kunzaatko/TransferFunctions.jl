@article{lalaoui2020,
  title = {Axial {{Point Spread Function Modeling}} by {{Application}} of {{Effective Medium Approximations}}: {{Widefield Microscopy}}},
  shorttitle = {Axial {{Point Spread Function Modeling}} by {{Application}} of {{Effective Medium Approximations}}},
  author = {Lalaoui, Lazhar and Bouafia, Mohamed and Issaad, Dahia and Medjahed, Aicha},
  year = {2020},
  month = jun,
  journal = {Optik},
  volume = {212},
  pages = {164646},
  issn = {0030-4026},
  doi = {10.1016/j.ijleo.2020.164646},
  urldate = {2023-11-12},
  abstract = {The main challenge of widefield microscopy (WFM) is to obtain a better axial resolution to collect optical sections of thick specimens. However, the consideration of the refractive index (RI) as a constant value does not accurately reflect the nature of heterogeneous objects as biological structures (cells, tissues{\dots}). The paper reports an improvement for the image processing in WFM when a thick and heterogeneous object is under observation. In this circumstance, the specifications for the microscope provided by the manufacturer are not useful due to aberrations appearing when light interacts with the heterogeneous structure under observation. The main contribution of this work is to model the optical response of the observed heterogeneous structure by effective medium approximations (EMA), such as: Lorentz-Lorenz, Maxwell Garnett, Bruggeman and Chemical mixture models. The information of the effective index of refraction of the observed object is introduced in the Gibson and Lanni model, which calculates the point spread function (PSF), which is given in terms of the optical path difference (OPD). The obtained results demonstrate that this model is not only effective to predict and interpret the image obtained by the WF microscope but also to improve the PSF results. In this latter case, a noticeable difference is observed compared to the simulations obtained with the Gibson and Lanni scalar model for three different microscope objectives.},
  file = {/home/kunzaatko/Zotero/storage/8XEYY4VK/lalaoui2020.pdf.pdf}
}
